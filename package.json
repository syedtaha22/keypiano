{
  "name": "keypiano",
  "version": "1.0.0",
  "description": "Laptop keyboard piano with a physically-modelled grand piano synthesiser",
  "author": "Syed Taha",
  "main": "src/main.cjs",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/syedtaha22/keypiano.git"
  },
  "scripts": {
    "start": "electron .",
    "lint": "eslint src --ext .js,.cjs",
    "lint:fix": "eslint src --ext .js,.cjs --fix",
    "format": "prettier --write \"src/**/*.{js,cjs}\"",
    "test": "node --test test/unit.test.js",
    "dist": "electron-builder --publish never",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-updater": "^6.3.0"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "playwright": "^1.60.0",
    "prettier": "^3.2.0"
  },
  "build": {
    "appId": "com.keypiano.desktop",
    "productName": "KeyPiano",
    "copyright": "Copyright © 2024 KeyPiano",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Audio"
    },
    "icon": "assets/icon.png",
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "publish": {
      "provider": "github",
      "owner": "syedtaha22",
      "repo": "keypiano"
    }
  }
}
